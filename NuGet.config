<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Sources are cleared and re-declared so a restore here depends only on nuget.org,
    regardless of what a developer or build agent has configured machine-wide.
    Central Package Management also requires either a single source or explicit
    source mapping (NU1507).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
